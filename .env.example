# SSH target for scripts/k3s-setup.sh. Format: user@host-or-ip.
# Required — the IP is intentionally not committed.
#
# Admin credentials and the Postgres DSN are NOT env vars at deploy time.
# They live in k8s/01-secrets.yaml (copy from k8s/01-secrets.yaml.example)
# and are injected into the portal pod as Kubernetes Secrets.
NAS_HOST=root@your-nas-ip
