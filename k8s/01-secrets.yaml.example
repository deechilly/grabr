# Copy to 01-secrets.yaml and fill in your values. Do NOT commit that file.
# Quotes are required — unquoted values that look like numbers will cause errors.
apiVersion: v1
kind: Secret
metadata:
  name: grabr-credentials
  namespace: grabr
stringData:
  GRABR_ADMIN_USER: "admin"
  GRABR_ADMIN_PASS: "change-me"
---
apiVersion: v1
kind: Secret
metadata:
  name: grabr-db
  namespace: grabr
stringData:
  POSTGRES_PASSWORD: "change-me"
  DATABASE_URL: "postgres://grabr:change-me@postgres.grabr.svc.cluster.local:5432/grabr?sslmode=disable"
